# Dependencies
node_modules

# Build output
build/
packages/*/build
*.tsbuildinfo

# Environment variables: only an example file is committed
.env
.env.*
!.env.example
.development.env

# Logs
logs
*.log
npm-debug.log*

# OS
.DS_Store

# Tests
/coverage
/.nyc_output

# Claude Code: .claude/settings.json is shared and committed, these are local
.claude/settings.local.json
.claude/worktrees/
graphify-out
# This checkout also keeps local notes under .claude - only settings.json is shared
.claude/*
!.claude/settings.json

# old (pre-v1) implementation kept locally for reference - never committed
/old

# Debug
packages/*/test/debug.ts

# Local-only dev shim - an absolute path into this checkout, never part of the package.
.devbin/

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
