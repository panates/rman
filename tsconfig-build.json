{
  "extends": "@panates/tsconfig/build.json",
  "compilerOptions": {
    /**
     * One package now, so this maps the one specifier its own sources could reach it by.
     * (`tsconfig-test.json` is the opposite case and maps every specifier, source-side: see the
     * note there.)
     *
     * It listed `rman-node` while that was a second workspace package, and a `"@rman/*"` entry
     * before that - left over from scoped names nothing ever shipped under, resolving to nothing
     * and quietly continuing to.
     */
    "paths": {
      "rman": ["./packages/rman/build/index.d.ts"]
    }
  }
}
