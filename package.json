{
  "name": "rman-repo",
  "description": "Repository manager - monorepo root",
  "version": "2.41.2",
  "private": true,
  "type": "module",
  "author": "Panates",
  "license": "MIT",
  "devDependencies": {
    "@panates/eslint-config-ts": "^2.3.4",
    "@panates/tsconfig": "^2.1.8",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.20",
    "@swc/helpers": "^0.5.23",
    "@types/envinfo": "^7.8.4",
    "@types/ini": "^4.1.1",
    "@types/js-yaml": "^4.0.9",
    "@types/micromatch": "^4.0.10",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "@types/signal-exit": "^4.0.0",
    "@types/yargs": "^17.0.35",
    "c8": "^12.0.0",
    "dpdm": "^4.3.0",
    "eslint": "^10.14.0",
    "expect": "^30.5.2",
    "globals": "^17.13.0",
    "mocha": "^12.0.3",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "ts-cleanup": "^1.4.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "scripts": {
    "build": "pnpm --filter rman run build",
    "smoke": "node support/smoke.cjs",
    "typecheck": "tsc --noEmit -p packages/rman/test",
    "test": "mocha",
    "precitest": "rimraf coverage",
    "citest": "c8 mocha",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --max-warnings=0 --fix",
    "format": "prettier . --write --log-level=warn",
    "graph": "graphify update ."
  },
  "engines": {
    "node": ">=20.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panates/rman.git"
  },
  "contributors": [
    "Eray Hanoglu <e.hanoglu@panates.com>",
    "Ilker Gurelli <i.gurelli@panates.com>",
    "Onur Tokel <o.tokel@panates.com>",
    "Bircan Yuruk <b.yuruk@panates.com>"
  ],
  "packageManager": "pnpm@12.10.1"
}
