{
  "name": "rman",
  "description": "Repository manager",
  "version": "2.17.0",
  "author": "Panates",
  "license": "MIT",
  "dependencies": {
    "@netlify/parse-npm-script": "^0.1.2",
    "@xmldom/xmldom": "^0.9.12",
    "@jsopen/objects": "^2.3.4",
    "ansi-colors": "^4.1.3",
    "cross-dirname": "^0.1.0",
    "easy-table": "^1.2.0",
    "envinfo": "^7.21.0",
    "fast-glob": "^3.3.3",
    "fast-tokenizer": "^1.10.0",
    "ini": "^7.0.0",
    "is-ci": "^4.1.0",
    "js-yaml": "^5.4.1",
    "micromatch": "^4.0.8",
    "npmlog": "^7.0.1",
    "power-tasks": "^1.14.2",
    "putil-merge": "^3.13.0",
    "putil-varhelpers": "^1.7.0",
    "semver": "^7.8.5",
    "signal-exit": "^4.1.0",
    "strict-typed-events": "^2.8.0",
    "strip-color": "^0.1.0",
    "tslib": "^2.8.1",
    "yargs": "^18.1.0"
  },
  "scripts": {
    "prepublishOnly": "node -e \"console.error('rman publishes from build/, never from the source tree. Run: rman publish'); process.exit(1)\"",
    "compile": "tsc --noEmit",
    "prebuild": "npm run check && npm run lint && npm run clean",
    "build": "tsc -b tsconfig-build.json",
    "postbuild": "node ../../support/postbuild.cjs && rimraf build/*.tsbuildinfo",
    "test": "mocha",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --max-warnings=0 --fix",
    "format": "prettier . --write --log-level=warn",
    "check": "dpdm -T --no-warning --no-tree --skip-dynamic-imports circular --exit-code circular:1 ./src/index.ts",
    "clean": "npm run clean:src && npm run clean:test && npm run clean:build && npm run clean:cover",
    "clean:src": "ts-cleanup -s src --all",
    "clean:test": "ts-cleanup -s test --all",
    "clean:build": "rimraf build *.tsbuildinfo",
    "clean:cover": "rimraf ../../coverage/http"
  },
  "type": "module",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./cli": {
      "types": "./cli.d.ts",
      "default": "./cli.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "rman": "cli.js"
  },
  "engines": {
    "node": ">=20.0"
  },
  "contributors": [
    "Eray Hanoglu <e.hanoglu@panates.com>",
    "Ilker Gurelli <i.gurelli@panates.com>",
    "Onur Tokel <o.tokel@panates.com>",
    "Bircan Yuruk <b.yuruk@panates.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panates/rman.git",
    "directory": "./packages/rman"
  },
  "keywords": [
    "javascript",
    "typescript",
    "monorepo",
    "repository",
    "build",
    "lerna"
  ],
  "publishConfig": {
    "access": "public"
  }
}
