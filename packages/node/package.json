{
  "name": "rman-node",
  "description": "Node.js support for rman - the commands and conventions that only mean something in a Node repository",
  "version": "1.2.3",
  "author": "Panates",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@netlify/parse-npm-script": "^0.1.2",
    "ansi-colors": "^4.1.3",
    "envinfo": "^7.21.0",
    "fast-glob": "^3.3.3",
    "semver": "^7.8.5",
    "yargs": "^18.1.0"
  },
  "peerDependencies": {
    "rman": ">=1.2.2 <2"
  },
  "scripts": {
    "compile": "tsc --noEmit",
    "prebuild": "rimraf build *.tsbuildinfo",
    "build": "tsc -b tsconfig-build.json",
    "postbuild": "node ../../support/postbuild.cjs && rimraf build/*.tsbuildinfo",
    "test": "mocha"
  },
  "type": "module",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.0"
  },
  "contributors": [
    "Eray Hanoglu <e.hanoglu@panates.com>",
    "Ilker Gurelli <i.gurelli@panates.com>",
    "Onur Tokel <o.tokel@panates.com>",
    "Bircan Yuruk <b.yuruk@panates.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panates/rman.git",
    "directory": "./packages/node"
  },
  "keywords": [
    "rman",
    "node",
    "nodejs",
    "npm",
    "monorepo",
    "repository",
    "release"
  ],
  "publishConfig": {
    "access": "public"
  }
}
